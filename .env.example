# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Create the bot token with @BotFather on Telegram.
# Channel IDs are the numeric chat IDs of your three Telegram channels
# (usually start with -100... for public channels / supergroups).
# See README.md for how to get them.

BOT_TOKEN=123456789:AAYourBotTokenHere

# Optional: free personal Kaggle API token -> enables cash-prize competition
# alerts. Get it at kaggle.com -> Settings -> API -> Create New Token.
# If unset, the Kaggle source is skipped.
KAGGLE_API_TOKEN=

TELANGANA_CHANNEL_ID=-1001234567890
INDIA_CHANNEL_ID=-1001234567890
GLOBAL_CHANNEL_ID=-1001234567890
