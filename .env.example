# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Create the bot token with @BotFather on Telegram.
# Channel IDs are the numeric chat IDs of your three Telegram channels
# (usually start with -100... for public channels / supergroups).
# See README.md for how to get them.

BOT_TOKEN=123456789:AAYourBotTokenHere

# Optional: free personal Kaggle API token -> enables cash-prize competition
# alerts. Get it at kaggle.com -> Settings -> API -> Create New Token.
# If unset, the Kaggle source is skipped.
KAGGLE_API_TOKEN=

TELANGANA_CHANNEL_ID=-1001234567890
INDIA_CHANNEL_ID=-1001234567890
GLOBAL_CHANNEL_ID=-1001234567890

# ---------------------------------------------------------------------------
# University Intelligence module (all optional; defaults shown)
# ---------------------------------------------------------------------------
# Minutes between daemon scans (default 30). Only used in Docker daemon mode;
# GitHub Actions uses its own cron.
SCAN_INTERVAL=30

# Comma-separated numeric chat IDs allowed to use admin commands
# (/adduniversity, /forcescan, ...). Leave empty to disable commands.
# Tip: send @userinfobot your id, or use the /getUpdates trick from README.
ADMIN_CHAT_IDS=

# Auto-seed the Telangana university list on first run (default true)
SEED_ON_EMPTY=true

# Try to discover event/RSS/innovation pages from each homepage (default true)
ENABLE_DISCOVERY=true

# Publish announcements with no opportunity category? (default false)
PUBLISH_OTHER_CATEGORY=false

# Only publish prize-money opportunities: announcement must mention a prize
# (cash prize, reward, ₹/Rs./$ amount...) or be a prize-awarding category
# (hackathons, contests, ideathons, ...). Plain workshops/conferences/bootcamps
# are dropped. (default true)
UNIVERSITY_REQUIRE_PRIZE=true

# Semantic dedupe provider: "local" (free, offline) or "grok" (paid xAI API)
SEMANTIC_PROVIDER=local
# Only needed when SEMANTIC_PROVIDER=grok
GROK_API_KEY=

# Optional: only scan these hosts (comma-separated). Empty = allow all.
# SCAN_ALLOWED_HOSTS=iith.ac.in,osmania.ac.in
